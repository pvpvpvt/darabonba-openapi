{
  "scope": "idpt",
  "name": "{{idpt}}-openapi",
  "version": "1.0.0",
  "main": "./main.dara",
  "libraries": {
    "Util": "darabonba:Util:*",
    "OpenApiUtil": "alibabacloud:OpenApiUtil:*",
    "Credential": "alibabacloud:Credential:*",
    "IdptCredential": "idpt:{{idpt}}-credential:*",
    "SPI": "alibabacloud:GatewaySPI:*",
    "XML": "darabonba:XML:*",
    "String": "darabonba:String:*"
  },
  "releases": {
    "ts": "@{{idpt}}/openapi-core:^1.0.0",
    "go": "{{openapi-go-git}}/client:v1.0.0",
    "csharp": "{{Idpt}}.OpenApiCore:1.0.0",
    "java": "com.{{idpt}}:openapi-core:1.0.0",
    "php": "{{idpt}}/openapi-core:^1.0.0",
    "python": "{{idpt}}-openapi-core:1.0.0"
  },
  "csharp": {
    "namespace": "{{Idpt}}.OpenApiCore",
    "packageInfo": {
      "name": "{{Idpt}}.OpenApiCore",
      "version": "1.0.0",
      "title": "{{idpt}}-openapi",
      "description": "{{Idpt}} Cloud OpenApi SDK Library for .NET",
      "company": "{{Idpt}} Cloud",
      "property": {
        "PackageTags": "{{Idpt}} OpenApi SDK",
        "Copyright": "©2009-present {{Idpt}} Cloud",
        "PackageProjectUrl": "{{openapi-csharp-git}}"
      }
    }
  },
  "java": {
    "package": "com.{{idpt}}.openapi",
    "NoException": true,
    "packageInfo": {
      "groupId": "com.{{idpt}}",
      "artifactId": "openapi-core",
      "version": "1.0.0",
      "description": "OpenApi SDK for Java",
      "url": "{{openapi-java-git}}",
      "licenseName": "The Apache License, Version 2.0",
      "licenseUrl": "http://www.apache.org/licenses/LICENSE-2.0.txt"
    }
  },
  "go": {
    "package": [
      "io"
    ]
  },
  "php": {
    "package": "{{Idpt}}.OpenApi",
    "clientName": "OpenApiClient",
    "packageInfo": {
      "name": "{idpt}/openapi-core",
      "desc": "{idpt} Cloud OpenApi Client",
      "github": "{{openapi-php-git}}"
    }
  },
  "python": {
    "package": "{idpt}_openapi",
    "clientName": "client",
    "packageInfo": {
      "name": "{idpt}-openapi-core",
      "desc": "{{Idpt}} Cloud openapi SDK Library for Python",
      "github": "{{openapi-python-git}}",
      "author": "{{Idpt}} Cloud SDK"
    }
  }
